# Zugangscode, den du auf Handy und PC eingibst.
APP_PASSWORD=

# Langer Zufallswert zum Signieren des Login-Cookies, z. B. openssl rand -base64 32
AUTH_SECRET=

# Upstash Redis über die Vercel-Integration. Speichert Buchliste und Lesestand.
# Vercel Blob erlaubt im Hobby-Tarif nur 2.000 Schreibvorgänge pro Monat,
# deshalb liegt der häufige Lesestand nicht im Blob.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Privater Vercel-Blob-Store für die HTML-Dateien.
# Auf Vercel den Store mit dem Projekt verbinden (OIDC). Kein Token ins Git.
# Lokal den Read-Write-Token aus dem Blob-Store hier eintragen.
BLOB_READ_WRITE_TOKEN=
